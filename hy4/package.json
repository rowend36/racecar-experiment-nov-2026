{
  "name": "redline-gp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "REDLINE GP — a cross-platform, high-performance 3D arcade racing game",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke.mjs",
    "test:browser": "npm run build && playwright test --config playwright.config.ts"
  },
  "dependencies": {
    "three": "0.170.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/three": "0.170.0",
    "typescript": "5.9.3",
    "vite": "6.4.6",
    "vitest": "4.1.12"
  }
}
