{
  "name": "vanta-gp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "VANTA GP \u2014 a cinematic cross-platform 3D arcade racer (WebGL2, HDR, procedural assets)",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "smoke": "npm run build && node scripts/smoke.mjs"
  },
  "dependencies": {
    "three": "0.170.0"
  },
  "devDependencies": {
    "@types/three": "0.170.0",
    "playwright-core": "^1.49.1",
    "typescript": "^5.6.3",
    "vite": "^6.0.7"
  }
}
